{
  "name": "terapiainfoco",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:backend & bun run dev:frontend & wait",
    "dev:landing": "bun run --cwd apps/landingpage dev",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "dev:backend": "bun run --cwd apps/backend dev",
    "start": "bun apps/backend/src/index.ts",
    "start:backend": "bun apps/backend/src/index.ts",
    "start:frontend": "bun apps/frontend/server.ts",
    "build": "bun run --cwd apps/frontend build",
    "build:landing": "bun run --cwd apps/landingpage build",
    "build:frontend": "bun run --cwd apps/frontend build",
    "build:backend": "bun run --cwd apps/backend build",
    "lint": "bun run --cwd apps/landingpage lint",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:push": "bun run --cwd apps/backend db:push",
    "test": "bun test",
    "test:load": "bun scripts/load-test.ts",
    "admin:create": "bun run --cwd apps/backend admin:create"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1"
  }
}
