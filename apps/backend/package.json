{
  "name": "@terapiainfoco/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@terapiainfoco/crypto": "workspace:*",
    "@terapiainfoco/shared": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.1",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.0"
  }
}
