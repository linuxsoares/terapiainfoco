# ==============================================================================
# TerapiaInFoco — Exemplo de Variáveis de Ambiente (.env)
# ==============================================================================

# --- SERVIDOR HTTP & AMBIENTE ---
# No Railway, PORT é injetado dinamicamente pela plataforma ($PORT).
PORT=3000
NODE_ENV=production

# --- BANCO DE DADOS POSTGRESQL (RFC-001) ---
# OBRIGATÓRIO em produção: sem DATABASE_URL o backend não inicia.
# Railway (plugin PostgreSQL): DATABASE_URL=${{Postgres.DATABASE_URL}}
# Supabase PostgreSQL: Copie em Project Settings -> Database -> Connection String (URI):
# Formato Pooler (recomendado na porta 6543 ou 5432):
DATABASE_URL=postgresql://postgres.seu_project_ref:sua_senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Formato Direto (porta 5432):
# DATABASE_URL=postgresql://postgres:sua_senha@db.seu_project_ref.supabase.co:5432/postgres?sslmode=require

# Apenas para ambientes de demonstração descartáveis: sobe sem DATABASE_URL usando PGlite em memória.
# ALLOW_EPHEMERAL_DATABASE=true
# Desenvolvimento local: persiste o PGlite em disco quando não houver DATABASE_URL.
# PGLITE_DATA_DIR=./.data/pglite

# Modo demonstração: cria contas fictícias com senha conhecida (Senha@123456) e habilita a vitrine 1-clique.
# Padrão: ligado em dev/testes, DESLIGADO em produção. Nunca habilite em um ambiente com dados reais.
# DEMO_MODE=false

# --- INTEGRAÇÃO COM ECOSSISTEMA SUPABASE ---
# URL da sua instância Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon/publishable key)
SUPABASE_PUBLISHABLE_KEY=sbp_...ou_eyJhbGciOi...
# Chave secreta de serviço (service_role key - NÃO expor no frontend)
SUPABASE_SECRET_KEY=sbp_...ou_eyJhbGciOi...
# Endpoint público JWKS para verificação assimétrica de JWTs
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# --- CACHE & RATE LIMITING DISTRIBUÍDO REDIS (OPCIONAL) ---
# No Railway: adicione o plugin Redis (opcional). Caso ausente, o sistema
# ativa automaticamente fallback gracioso para cache seguro em memória RAM.
# REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://default:sua_senha@redis.railway.internal:6379

# --- SEGURANÇA, CRIPTOGRAFIA & LGPD ---
# Chave secreta de alta entropia para assinatura de tokens JWT locais (Access & Refresh tokens).
# Gere com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_jwt_de_producao_super_segura_2026

# Salt secreto exclusivo para o Blind Index determinístico (HMAC-SHA256) de CPF e e-mail.
# ⚠️ IMPORTANTE: Nunca altere este valor em produção após cadastrar pacientes, pois
# as buscas indexadas de dados de saúde dependem dessa invariante criptográfica.
BLIND_INDEX_SALT=seu_salt_secreto_blind_index_para_busca_exata_lgpd_2026

# Chave AES-256 (32 bytes) da criptografia Field-Level (nome, e-mail, CPF, telefone, notas clínicas).
# OBRIGATÓRIA em produção. Gere UMA vez com: openssl rand -base64 32
# ⚠️ Nunca altere nem perca este valor: dados cifrados com a chave anterior tornam-se irrecuperáveis.
FIELD_ENCRYPTION_KEY=

# KEK mestre (32 bytes) do KMS local para Envelope Encryption (DEKs por paciente/terapeuta).
# OBRIGATÓRIA em produção. Gere UMA vez com: openssl rand -base64 32 (mesmas restrições acima).
KMS_MASTER_KEY=

# --- INTEGRAÇÃO DO FRONTEND COM A API ---
# URL pública do backend na Railway para consumo pelo painel do psicólogo (apps/frontend).
# Exemplo: https://terapiainfoco-backend-production.up.railway.app/api
VITE_API_URL=https://sua-url-backend.up.railway.app/api

# --- TELECONSULTA PRÓPRIA (RFC-001 §3.2, ADR-005) ---
# URL pública do painel (frontend): base do link da sala de cada consulta (?sala=<id>).
PUBLIC_APP_URL=https://sua-url-frontend.up.railway.app

# Servidores ICE da teleconsulta (WebRTC). STUN descobre a rota; TURN retransmite a mídia quando
# a conexão direta é bloqueada (NAT simétrico, firewalls corporativos). Use um TURN gerenciado
# (ex.: Cloudflare, Twilio, Metered) e mantenha as credenciais fora do código.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.exemplo.com:3478?transport=udp,turns:turn.exemplo.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
