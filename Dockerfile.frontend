# ==============================================================================
# TerapiaInFoco Frontend — Dockerfile de Produção (Vite SPA)
# ==============================================================================

# Estágio 1: Build
FROM oven/bun:1-alpine AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY packages ./packages
COPY apps/frontend ./apps/frontend

RUN bun install --frozen-lockfile

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN bun run build:frontend

# Estágio 2: Execução leve com Bun Nativo (SPA routing fallback)
FROM oven/bun:1-alpine AS runner
WORKDIR /app

COPY --from=builder /app/apps/frontend/dist ./dist

ENV NODE_ENV=production
ENV PORT=80
EXPOSE 80

CMD ["bun", "-e", "const port = Number(process.env.PORT) || 80; const fs = require('fs'); const path = require('path'); Bun.serve({ port, async fetch(req) { const p = new URL(req.url).pathname; const target = path.join('./dist', p); const file = fs.existsSync(target) && fs.statSync(target).isFile() ? Bun.file(target) : Bun.file('./dist/index.html'); return new Response(file); } }); console.log(`Frontend TerapiaInFoco rodando na porta ${port}`);"]
