# ==============================================================================
# TerapiaInFoco Frontend — Dockerfile de Produção (Vite SPA)
# ==============================================================================

# Estágio 1: Build
FROM oven/bun:1-alpine AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY packages ./packages
COPY apps/frontend ./apps/frontend

RUN bun install --frozen-lockfile

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Compila o frontend diretamente dentro de apps/frontend sem depender de --filter
RUN cd apps/frontend && bun run build

# Estágio 2: Execução com Servidor Bun Nativo
FROM oven/bun:1-alpine AS runner
WORKDIR /app

COPY package.json ./
COPY --from=builder /app/apps/frontend/dist ./apps/frontend/dist
COPY apps/frontend/server.ts ./apps/frontend/server.ts
COPY apps/frontend/package.json ./apps/frontend/package.json

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Executa o servidor estático dedicado com binding em 0.0.0.0:$PORT
CMD ["bun", "apps/frontend/server.ts"]
